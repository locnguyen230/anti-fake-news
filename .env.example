# Copy to .env at repository root. Values below are configuration examples.
AFN_HOST=127.0.0.1
AFN_PORT=8000
# The deployment profile requires a token and an approved frozen bundle.
AFN_ENVIRONMENT=production
AFN_PREDICTOR_MODE=real
# Supply a private token before starting production.
AFN_DEMO_TOKEN=
# Set to chrome-extension:// followed by your real 32-character extension ID.
# Enforced by LocalCORSMiddleware; empty disables cross-origin browser CORS grants.
AFN_EXTENSION_ORIGIN=
# Relative paths resolve from the repository root.
AFN_MODEL_ARTIFACT_PATH=backend/artifacts/multimodal
# Use the approved SHA-256 of metadata.json from the model handoff.
AFN_MODEL_METADATA_SHA256=
# Enforced total body cap, including multipart overhead; default pending review.
AFN_MAX_REQUEST_BYTES=12582912

